{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/c/Users/fedor/Code/uncensored-ai"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "/c/Users/fedor/Code/uncensored-ai"
      ],
      "enabled": true
    }
  },
  "lsp": true,
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "filesystem_*": "ask",
    "git_*": "ask"
  }
}
